
CFLAGS=-Wall -std=c99 -D_POSIX_C_SOURCE=200809L
INCLUDES=-I./inc

GENERATOR_SRCS=src/errExit.c src/generator.c
MULTIPLIER_SRCS=src/report.c src/multiplier.c

GENERATOR_OBJS=$(GENERATOR_SRCS:.c=.o)
MULTIPLIER_OBJS=$(MULTIPLIER_SRCS:.c=.o)
SRCS=$(GENERATOR_SRCS) $(MULTIPLIER_SRCS)
OBJS=$(GENERATOR_OBJS) $(MULTIPLIER_OBJS)

all: generator multiplier

generator: $(GENERATOR_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

multiplier: $(MULTIPLIER_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o generator multiplier
	@echo "Removed object files and executables..."
