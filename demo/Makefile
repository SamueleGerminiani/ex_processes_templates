
# Part 1 - the administrator's toolkit: one small program per phenomenon
CFLAGS=-Wall -std=c99 -D_POSIX_C_SOURCE=200809L
INCLUDES=-I./inc

PROGS=fork_demo zombie_demo orphan_demo status_demo exec_demo hello redirect_demo
SRCS=src/errExit.c src/fork.c src/zombie.c src/orphan.c src/status.c src/exec.c src/hello.c src/redirect.c
OBJS=$(SRCS:.c=.o)

all: $(PROGS)

%_demo: src/%.o src/errExit.o
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

hello: src/hello.o
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

src/%.o: src/%.c
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean
.SECONDARY:

clean:
	@rm -f src/*.o $(PROGS) demo.log
	@echo "Removed object files and executables..."
